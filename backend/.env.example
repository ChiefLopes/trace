# ==============================================================================
# TRACE Backend Environment Configuration Example
# Copy to .env and adjust variables for your environment.
# ==============================================================================

# Application
APP_NAME=TRACE API
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080
SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Database Configuration
# - For local development:
DATABASE_URL=sqlite:///./trace.db
# - For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname:5432/trace_prod

# Redis Configuration (JWT Blacklist)
REDIS_URL=redis://localhost:6379/0

# Allowed CORS Origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Admin Panel Credentials & Session (Seeded on startup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tracegame.io
ADMIN_PASSWORD=change-this-admin-password-in-prod
ADMIN_SECRET_KEY=change-this-admin-session-secret-key-in-prod

# Google OAuth / Sign-In (Optional)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

