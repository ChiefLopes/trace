# =============================================================================
# TRACE Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored — never commit secrets.

# -----------------------------------------------------------------------------
# Auth / Session
# -----------------------------------------------------------------------------
# 32+ char secret for signing the frontend session marker. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Admin Panel Credentials & Session (Seeded on startup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tracegame.io
ADMIN_PASSWORD=TraceAdminSecret2026!

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
# Base URL of the TRACE backend API. Used by serverApi (Server Components/Actions).
# In development, Next.js rewrites /api/* to this URL.
# In production, must be set at build time for rewrites to work.
API_BASE_URL=https://trace-backend.fastapicloud.dev

# -----------------------------------------------------------------------------
# Public (client-safe) — prefixed with NEXT_PUBLIC_
# -----------------------------------------------------------------------------
# Your deployed frontend URL. Used for absolute URLs, OAuth redirects, etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Middleware / Proxy (optional customization)
# -----------------------------------------------------------------------------
# Cookie holding the backend access token. Keep HttpOnly; Proxy forwards it as Bearer.
# BACKEND_AUTH_COOKIE=trace_backend_token

# Comma-separated list of API path prefixes that require the auth header.
# These are forwarded as Authorization: Bearer <cookie> to the backend.
# PROTECTED_API_PATHS=/api/auth/session,/api/auth/logout,/api/user/,/api/me/,/api/cases/

# -----------------------------------------------------------------------------
# Feature Flags (optional)
# -----------------------------------------------------------------------------
# Enable player's chosen investigator in UI (vs. default from designs)
SHOW_PLAYER_CHOICE=true

# -----------------------------------------------------------------------------
# External Services (when implemented)
# -----------------------------------------------------------------------------
# Google OAuth client ID for "Sign in with Google"
# GOOGLE_CLIENT_ID=

# Solana RPC endpoint (for wallet verification, if done client-side)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
